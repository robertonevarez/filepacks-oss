{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.filepacks.dev/evals/run.schema.json",
  "title": "filepacks eval run metadata",
  "type": "object",
  "required": ["id", "task_type", "repository", "agent", "model", "timestamp"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^run-[0-9]{4,}$"
    },
    "task_type": {
      "type": "string",
      "enum": ["bugfix", "refactor", "docs_update", "ui_change", "db_migration", "api_integration", "ci_fix", "test_repair", "other"]
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "expected_evidence_paths": {
      "description": "Paths passed to measureRunEvidence().expectedEvidencePaths.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_issue_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "issue_url": {
      "type": "string",
      "pattern": "^https://github\\.com/[^/]+/[^/]+/issues/[0-9]+$"
    },
    "executor_tool": {
      "type": "string",
      "enum": ["opencode"]
    },
    "provider": {
      "type": "string",
      "enum": ["github-copilot"]
    },
    "model_identifier": {
      "type": ["string", "null"]
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_ref": {
      "type": "string",
      "minLength": 1
    },
    "environment_preflight": {
      "type": "object"
    },
    "model_substitution_reason": {
      "type": ["string", "null"]
    },
    "status": {
      "type": "string",
      "enum": ["not_executed", "incomplete", "completed", "failed", "rejected"]
    },
    "executor_prompt": {
      "type": "string",
      "minLength": 1
    },
    "executor_command": {
      "type": "string",
      "minLength": 1
    },
    "baseline_group": {
      "type": "string",
      "enum": ["loose_files", "filepacks_artifact"]
    },
    "notes": {
      "type": "string"
    }
  }
}
