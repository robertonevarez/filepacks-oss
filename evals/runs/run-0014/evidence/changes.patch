+import yargs from '../index.mjs';
+
+function makeCommands() {
+  return yargs()
+    .command('help', 'Show help menu for commands', () => {})
+    .command('exit', 'Disconnect from the world', () => {})
+    .command('where', 'Get current location', () => {})
+    .command('come', 'Walk to the sender', () => {})
+    .command(
+      'build <prompt>',
+      'Build something based on a prompt',
+      (y) => y.positional('prompt', { type: 'string', describe: 'Prompt' })
+    );
+}
+
+function parseCommand(input) {
+  // simple split to simulate stringArgv; this matches the user's example
+  const argv = input.split(/\s+/).filter(Boolean);
+  try {
+    return makeCommands()
+      .exitProcess(false)
+      .strictCommands()
+      .fail((msg) => {
+        // replicate user behavior: throw on fail
+        throw new Error(msg);
+      })
+      .parseSync(argv);
+  } catch (err) {
+    // print the thrown error message for reproduction capture
+    console.error('THROW:', err && err.message ? err.message : String(err));
+    // rethrow to preserve non-zero exit code if run directly
+    throw err;
+  }
+}
+
+// Run reproduction
+parseCommand('fly away');
